{
  "expo": {
    "name": "AniTrack",
    "slug": "anitrack",
    "scheme": "anitrack",
    "newArchEnabled": false,
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-empty.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paladex.anitrack"
    },
    "android": {
      "package": "com.paladex.anitrack",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ]
  }
}